<mxfile host="app.diagrams.net">
<diagram name="Keva Vision — how a night becomes a page">
<mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1640" pageHeight="940" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="lane0" value="THE VENUE &#8212; hardware that is already in the ceiling" style="rounded=1;fillColor=#F5F1EB;strokeColor=#DDD5CB;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontColor=#D4622B;fontFamily=JetBrains Mono;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="24" y="96" width="1592" height="164" as="geometry"/></mxCell>
<mxCell id="lane1" value="KEVA VISION &#8212; the automated pass · kevacv/pipeline.py" style="rounded=1;fillColor=#F5F1EB;strokeColor=#DDD5CB;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontColor=#D4622B;fontFamily=JetBrains Mono;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="24" y="296" width="1592" height="480" as="geometry"/></mxCell>
<mxCell id="lane2" value="WHAT A HUMAN SEES &#8212; the whole point" style="rounded=1;fillColor=#F5F1EB;strokeColor=#DDD5CB;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontColor=#D4622B;fontFamily=JetBrains Mono;fontSize=13;html=1;" vertex="1" parent="1"><mxGeometry x="24" y="812" width="1592" height="300" as="geometry"/></mxCell>
<mxCell id="a1" value="39 cameras + 3 door readers<br><i style="color:#8B7E6F;font-size:12px">UniFi Protect · 44 devices · all online</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#DDD5CB;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="128" width="300" height="96" as="geometry"/></mxCell>
<mxCell id="a2" value="UNVR Pro recorder<br><i style="color:#8B7E6F;font-size:12px">10.0.14.10 · already installed</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#DDD5CB;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="440" y="128" width="250" height="96" as="geometry"/></mxCell>
<mxCell id="a3" value="≈312 camera-hours a night<br><i style="color:#8B7E6F;font-size:12px">nobody watches them</i>" style="rounded=1;arcSize=8;fillColor=#FCEADB;strokeColor=#7C2D12;fontColor=#7C2D12;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="760" y="128" width="320" height="96" as="geometry"/></mxCell>
<mxCell id="b1" value="1 · PREFLIGHT<br><i style="color:#8B7E6F;font-size:12px">Is this run trustworthy at all?</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D4622B;strokeWidth=2;fontColor=#1C1917;fontFamily=JetBrains Mono;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="336" width="290" height="104" as="geometry"/></mxCell>
<mxCell id="b2" value="2 · ANALYSE<br><i style="color:#8B7E6F;font-size:12px">Find every person, follow them</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D4622B;strokeWidth=2;fontColor=#1C1917;fontFamily=JetBrains Mono;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="336" width="290" height="104" as="geometry"/></mxCell>
<mxCell id="b3" value="3 · PHANTOMS<br><i style="color:#8B7E6F;font-size:12px">Drop reflections, statues, posters</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D4622B;strokeWidth=2;fontColor=#1C1917;fontFamily=JetBrains Mono;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="770" y="336" width="290" height="104" as="geometry"/></mxCell>
<mxCell id="b4" value="4 · IDENTITY<br><i style="color:#8B7E6F;font-size:12px">One person = one id</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D4622B;strokeWidth=2;fontColor=#1C1917;fontFamily=JetBrains Mono;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1120" y="336" width="290" height="104" as="geometry"/></mxCell>
<mxCell id="b5" value="5 · ANSWERS<br><i style="color:#8B7E6F;font-size:12px">4 questions, each with a tier</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D4622B;strokeWidth=2;fontColor=#1C1917;fontFamily=JetBrains Mono;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1120" y="530" width="290" height="104" as="geometry"/></mxCell>
<mxCell id="d1" value="Camera moved, or data invalid?" style="rhombus;fillColor=#FFFFFF;strokeColor=#1C1917;strokeWidth=2;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="524" width="340" height="116" as="geometry"/></mxCell>
<mxCell id="b6" value="6 · REPORT<br><i style="color:#8B7E6F;font-size:12px">One page, published at 06:00</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D4622B;strokeWidth=2;fontColor=#1C1917;fontFamily=JetBrains Mono;fontSize=14;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="530" width="290" height="104" as="geometry"/></mxCell>
<mxCell id="stop" value="NOTHING IS PUBLISHED<br><i style="color:#8B7E6F;font-size:12px">a wrong number is worse than none</i>" style="rounded=1;arcSize=8;fillColor=#7C2D12;strokeColor=#7C2D12;fontColor=#FFF7F5;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1080" y="664" width="340" height="96" as="geometry"/></mxCell>
<mxCell id="c1" value="The morning report<br><i style="color:#8B7E6F;font-size:12px">read in 2 minutes, not 8 hours</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1C1917;strokeWidth=2;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="70" y="852" width="320" height="108" as="geometry"/></mxCell>
<mxCell id="c2" value="Anomalies to review<br><i style="color:#8B7E6F;font-size:12px">only the deviations, with a timestamp</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1C1917;strokeWidth=2;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="852" width="340" height="108" as="geometry"/></mxCell>
<mxCell id="c3" value="Annotated video<br><i style="color:#8B7E6F;font-size:12px">jump to the moment worth watching</i>" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1C1917;strokeWidth=2;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="852" width="320" height="108" as="geometry"/></mxCell>
<mxCell id="c4" value="Learned baseline · this venue’s normal per zone, hour and weekday<br><i style="color:#8B7E6F;font-size:12px">built from every night that came before</i>" style="rounded=1;arcSize=8;fillColor=#FDF5EF;strokeColor=#D4622B;fontColor=#1C1917;fontFamily=Space Grotesk;fontSize=15;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="1000" width="720" height="92" as="geometry"/></mxCell>
